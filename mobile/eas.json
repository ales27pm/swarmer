{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "credentialsSource": "local",
      "node": "22.23.2",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "distribution": "store",
      "credentialsSource": "local",
      "node": "22.23.2",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "cloud-release": {
      "extends": "production",
      "credentialsSource": "remote"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appName": "monGARS Swarm",
        "bundleIdentifier": "org.27pm.mongars",
        "language": "fr-CA",
        "sku": "mongars-swarm-20260907"
      }
    }
  }
}
