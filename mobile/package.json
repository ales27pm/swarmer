{
  "name": "mongars-mobile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "eas-build-on-success": "node scripts/verify-eas-ios-archive.cjs"
  },
  "dependencies": {
    "@vibecodeapp/sdk": "^0.4.15",
    "expo": "~55.0.31",
    "expo-build-properties": "~55.0.18",
    "expo-calendar": "~55.0.19",
    "expo-constants": "~55.0.17",
    "expo-contacts": "~55.0.18",
    "expo-dev-client": "~55.0.40",
    "expo-document-picker": "~55.0.17",
    "expo-file-system": "55.0.26",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.24",
    "expo-linking": "~55.0.17",
    "expo-location": "~55.1.14",
    "expo-mail-composer": "~55.0.18",
    "expo-router": "~55.0.18",
    "expo-secure-store": "~55.0.18",
    "expo-sms": "~55.0.18",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4"
  },
  "devDependencies": {
    "@jest/globals": "~29.7.0",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~55.0.1",
    "expo-doctor": "1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.22",
    "test-renderer": "1.2.0",
    "typescript": "latest"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  },
  "expo": {
    "autolinking": {
      "apple": {
        "buildFromSource": [
          "expo-contacts"
        ]
      }
    }
  },
  "overrides": {
    "@teovilla/react-native-web-maps": {
      "expo-location": "$expo-location"
    }
  }
}
