{
  "expo": {
    "name": "monGARS Swarm",
    "slug": "mongars-swarm",
    "owner": "27pm",
    "scheme": "mongars",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "SwarmerLlamaBinary",
                "podspec": "https://raw.githubusercontent.com/ales27pm/swarmer/4f999098fd42993ae87308719bc1261905e46f9e/mobile/modules/swarmer-local-inference/ios/LlamaBinary/SwarmerLlamaBinary.podspec"
              }
            ]
          }
        }
      ],
      "expo-secure-store",
      "expo-sqlite"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.27pm.mongars",
      "buildNumber": "20260908033230",
      "deploymentTarget": "18.0",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleLocalizations": [
          "fr"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "monGARS Swarm se connecte à votre serveur d’agents autorisé sur le réseau local."
      }
    },
    "android": {
      "package": "org.twentysevenpm.mongars"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "09308b10-5d9d-4a55-a6ba-7973f634741a"
      }
    }
  }
}
