# Register agent-card-chroma.json before enabling this worker.
# Keep private credentials outside the repository.
MONGARS_SERVER_URL=http://127.0.0.1:8710
MONGARS_AGENT_ID=replace-with-registered-chroma-agent
MONGARS_AGENT_CREDENTIAL=replace-with-worker-credential
MONGARS_MEDIA_SKILL=image.generate
MONGARS_MEDIA_PROFILE=/absolute/private/models/chroma1-hd-q4/profile.json
# Includes integrity verification, model loading and rendering; no hidden retry.
MONGARS_MEDIA_TIMEOUT_SECONDS=600
MONGARS_MEDIA_MAX_RSS_BYTES=12884901888
# Set 1 only after installing the exact manifest and qualifying this worker instance.
MONGARS_MEDIA_GPU_ENABLED=0
# Required in deployed Linux worker; the native renderer gets an offline namespace.
MONGARS_MEDIA_SANDBOX=1
# Same operator-owned 0600 file configured by Chroma Studio; do not unlink it.
MONGARS_MEDIA_GPU_LOCK=/home/ales27pm/.local/state/swarmer-gpu/image-generation.lock
