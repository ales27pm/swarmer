# Configure separate registered workers and virtual environments for audio and image.
MONGARS_SERVER_URL=http://127.0.0.1:8710
MONGARS_AGENT_ID=replace-with-registered-audio-agent
MONGARS_AGENT_CREDENTIAL=replace-with-worker-credential
MONGARS_MEDIA_SKILL=audio.synthesize
MONGARS_MEDIA_PROFILE=/absolute/private/models/kokoro/profile.json
# Unset defaults to 180 for audio and 600 for image.
MONGARS_MEDIA_TIMEOUT_SECONDS=180
# Optional override; unset uses 4294967296 for audio, 12884901888 for image.
# MONGARS_MEDIA_MAX_RSS_BYTES=4294967296
# Leave disabled until the image profile, driver and CUDA runtime have been qualified.
MONGARS_MEDIA_GPU_ENABLED=0
