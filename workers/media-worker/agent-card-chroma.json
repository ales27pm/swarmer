{
  "manifest_version": "1",
  "name": "mongars-local-chroma-worker",
  "version": "0.1.0",
  "protocol": "mongars-worker-v0.9",
  "skills": [{"id": "image.generate", "risk": "low", "result_trust": "untrusted"}],
  "limits": {"max_concurrency": 1, "max_result_bytes": 64000, "max_operation_seconds": 600},
  "policy": {"filesystem": "isolated-media-scratch", "network": "control-plane-and-loopback-model-only", "writes": true, "shell": false}
}
