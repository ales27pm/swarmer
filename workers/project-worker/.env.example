PYTHONDONTWRITEBYTECODE=1
MONGARS_SERVER_URL=https://control-plane.example.invalid
MONGARS_AGENT_ID=agt_replace_me
MONGARS_AGENT_CREDENTIAL=replace_with_one_time_registration_credential
MONGARS_PROJECT_MODEL_URL=http://127.0.0.1:11434/v1
MONGARS_PROJECT_MODEL_ID=swarmer-project-qwen3-coder:30b-32k-06c1097e
MONGARS_PROJECT_MODEL_TIMEOUT_SECONDS=240
# Defaults; context accepts 32768..64000, prompt is UTF-8 bytes (minimum 10000).
# Require prompt bytes + 2000 output tokens + 1024 framing tokens <= context tokens.
MONGARS_PROJECT_MODEL_CONTEXT_TOKENS=32768
MONGARS_PROJECT_PROMPT_MAX_BYTES=22000
# Coordinated trial: set the two values above to 64000 and 50000 respectively;
# also align the server handoff budget. Output and time limits remain unchanged.
# Run setup_runtime.sh; use its exact local image ID, never a mutable tag.
MONGARS_PROJECT_RUNTIME_IMAGE=sha256:replace_with_runtime_image_id
# Launcher only: create this dedicated operator-owned directory with mode0700.
MONGARS_PROJECT_SCRATCH_DIR=/var/tmp/swarmer-project-worker-1000
