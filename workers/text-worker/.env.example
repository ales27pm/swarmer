PYTHONDONTWRITEBYTECODE=1
MONGARS_SERVER_URL=https://control-plane.example.invalid
MONGARS_AGENT_ID=agt_replace_me
MONGARS_AGENT_CREDENTIAL=replace_with_one_time_registration_credential
# Existing operator-installed local alias; the worker never downloads models.
# Use the same model ID during worker registration. Choose a small CPU-capable
# model (around 7B or smaller) able to finish 512 tokens inside the time budget.
MONGARS_TEXT_MODEL_ID=replace_with_installed_local_model_alias
MONGARS_TEXT_MODEL_URL=http://127.0.0.1:11434
MONGARS_TEXT_TIMEOUT_SECONDS=120
MONGARS_JOB_HEARTBEAT_SECONDS=10
