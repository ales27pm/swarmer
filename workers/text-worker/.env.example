PYTHONDONTWRITEBYTECODE=1
MONGARS_SERVER_URL=https://control-plane.example.invalid
MONGARS_AGENT_ID=agt_replace_me
MONGARS_AGENT_CREDENTIAL=replace_with_one_time_registration_credential
# Existing operator-installed local alias; the worker never downloads models.
# Use the same model ID during worker registration. Choose a small local
# model and qualify its requested response lengths on the selected hardware inside
# the time budget. Output allowances adapt between 1024 and 8192 tokens.
MONGARS_TEXT_MODEL_ID=replace_with_installed_local_model_alias
MONGARS_TEXT_MODEL_URL=http://127.0.0.1:11434
# Absolute generation budget, finite 1..600 seconds; default remains 120.
# Includes model-server queue, loading, prompt processing and generation.
# Job leases renew in the background; the default 60-second lease is not a job cap.
MONGARS_TEXT_TIMEOUT_SECONDS=120
# Separate finite 1..600 second phase budgets; the absolute total always wins.
# First-content covers request upload, queue/load/prefill until final text starts.
# Idle resets only on nonempty final-content events, not empty/thinking events.
MONGARS_TEXT_CONNECT_TIMEOUT_SECONDS=10
MONGARS_TEXT_FIRST_CONTENT_TIMEOUT_SECONDS=120
MONGARS_TEXT_IDLE_TIMEOUT_SECONDS=30
# CPU by default. Optional integer 1..128 requests GPU layers from Ollama.
# Qualify actual placement, VRAM usage and shared-role contention before enabling.
# This is not a VRAM reservation; no automatic fallback retry is performed.
MONGARS_TEXT_GPU_LAYERS=0
MONGARS_JOB_HEARTBEAT_SECONDS=10
