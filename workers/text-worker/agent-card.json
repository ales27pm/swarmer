{
  "manifest_version": "1",
  "name": "mongars-text-worker",
  "version": "0.14.3",
  "protocol": "mongars-worker-v0.9",
  "skills": [{"id": "writing.draft", "risk": "low", "result_trust": "untrusted"}],
