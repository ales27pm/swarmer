{
  "manifest_version": "1",
  "name": "mongars-code-worker",
  "version": "0.13.0",
  "protocol": "mongars-worker-v0.9",
  "skills": [{"id": "code.generate_python", "risk": "low", "result_trust": "untrusted"}],
