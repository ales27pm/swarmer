PYTHONDONTWRITEBYTECODE=1
MONGARS_SERVER_URL=https://control-plane.example.invalid
MONGARS_AGENT_ID=agt_replace_me
MONGARS_AGENT_CREDENTIAL=replace_with_one_time_registration_credential
# Default abliterated worker preset; launch the pinned G9 GGUF from server/README.md.
# Use this exact model_id when registering the worker. Explicit local aliases
# remain supported for an operator's existing inference deployment.
MONGARS_CODE_MODEL_URL=http://127.0.0.1:8712/v1
MONGARS_CODE_MODEL_ID=G9v3-3B-Heretic-Abliterated
MONGARS_CODE_TIMEOUT_SECONDS=90
MONGARS_JOB_HEARTBEAT_SECONDS=10
