{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://27pm.org/schemas/feedback-event.schema.json",
  "title": "monGARS Feedback Event",
  "description": "Current feedback resource persisted by the control plane.",
  "type": "object",
  "required": ["id", "task_id", "agent_id", "type", "label", "score", "notes", "payload", "created_at"],
  "properties": {
    "id": {"type": "string"},
    "task_id": {"type": ["string", "null"]},
    "agent_id": {"type": ["string", "null"]},
    "type": {"type": "string", "minLength": 1, "maxLength": 100},
    "label": {"type": ["string", "null"], "maxLength": 200},
    "score": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
    "notes": {"type": ["string", "null"], "maxLength": 4000},
    "payload": {"type": "object"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
