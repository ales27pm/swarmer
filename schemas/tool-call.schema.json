{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://27pm.org/schemas/tool-call.schema.json",
  "title": "monGARS Tool Call",
  "type": "object",
  "required": ["id", "task_id", "agent_id", "tool", "arguments"],
  "properties": {
    "id": {"type": "string"},
    "task_id": {"type": "string"},
    "agent_id": {"type": "string"},
    "tool": {"type": "string"},
    "arguments": {"type": "object"},
    "reason": {"type": "string"},
    "expected_risk": {"enum": ["none", "low", "medium", "high", "critical", "unknown"]},
    "requires_permission": {"type": "boolean"}
  },
  "additionalProperties": false
}
