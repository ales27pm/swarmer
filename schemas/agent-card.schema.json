{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://27pm.org/schemas/agent-card.schema.json",
  "title": "monGARS Agent",
  "description": "Current authenticated agent resource returned by the control plane.",
  "type": "object",
  "required": ["id", "name", "version", "endpoint", "model_id", "status", "skills", "last_heartbeat_at", "last_seen_at", "max_concurrency", "capacity", "active_jobs", "historical_score", "created_at", "updated_at"],
  "properties": {
    "id": {"type": "string"},
    "name": {"type": "string"},
    "version": {"type": "string"},
    "endpoint": {"type": "string", "format": "uri"},
    "model_id": {"type": ["string", "null"]},
    "status": {"enum": ["online", "offline", "busy", "draining", "unverified"]},
    "skills": {"type": "array", "items": {"type": "string"}},
    "last_heartbeat_at": {"type": ["string", "null"], "format": "date-time"},
    "last_seen_at": {"type": ["string", "null"], "format": "date-time"},
    "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 32},
    "capacity": {"type": "object", "additionalProperties": {"type": "integer"}},
    "active_jobs": {"type": "integer", "minimum": 0},
    "historical_score": {"type": "number"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
