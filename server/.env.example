MONGARS_ENV=dev
MONGARS_HOST=0.0.0.0
MONGARS_PORT=8710
MONGARS_DB_PATH=./data/mongars.db
MONGARS_WORKSPACE_ROOT=./workspace
# SQLite remains the default durable notification transport.
MONGARS_MESSAGE_BOARD_BACKEND=sqlite
MONGARS_REDIS_URL=redis://127.0.0.1:6379/0
MONGARS_REDIS_STREAM_PREFIX=mongars
MONGARS_REDIS_OPERATION_TIMEOUT_SECONDS=2
MONGARS_REDIS_STREAM_MAXLEN=10000
MONGARS_REDIS_STREAM_RETENTION_SECONDS=604800
MONGARS_OUTBOX_PUBLICATION_LEASE_SECONDS=30
MONGARS_CONTROL_PLANE_HEARTBEAT_SECONDS=10
MONGARS_MAINTENANCE_LEASE_SECONDS=45
# FAISS is an optional rebuildable projection; SQLite memory stays authoritative.
MONGARS_VECTOR_BACKEND=sqlite
MONGARS_VECTOR_INDEX_PATH=./data/vector-index
MONGARS_VECTOR_INDEX_GENERATIONS_TO_KEEP=2
MONGARS_LLM_BASE_URL=http://127.0.0.1:8711/v1
MONGARS_ORCHESTRATOR_MODEL=Hermes-3-Llama-3.2-3B-abliterated
# Optional. Set both to enable SQLite-backed hybrid memory ranking.
# MONGARS_EMBEDDING_BASE_URL=http://127.0.0.1:8711/v1
# MONGARS_EMBEDDING_MODEL=intfloat/multilingual-e5-small
MONGARS_PERMISSIONS_PATH=../configs/permissions.yaml
# Required to generate a pairing code. Create with: openssl rand -hex 32
MONGARS_PAIRING_BOOTSTRAP_TOKEN=replace-with-a-long-random-operator-token
MONGARS_PAIRING_CODE_TTL_SECONDS=600
MONGARS_PAIRING_CANDIDATE_TTL_SECONDS=120
MONGARS_PAIRING_MAX_ATTEMPTS=10
MONGARS_WEBSOCKET_IO_TIMEOUT_SECONDS=5
# Metadata-only cross-process delivery journal; staleness must exceed the
# control-plane heartbeat interval.
MONGARS_WEBSOCKET_NOTIFICATION_POLL_SECONDS=0.1
MONGARS_WEBSOCKET_NOTIFICATION_INSTANCE_STALE_SECONDS=60
# Keep false outside an isolated development loopback.
MONGARS_ALLOW_INSECURE_REMOTE_HTTP=false
